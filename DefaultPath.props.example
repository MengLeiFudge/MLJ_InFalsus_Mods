<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup Label="DefaultPath">
    <!-- AfterBuildEvent 会把 Steam 直启绑定到这个 profile。 -->
    <ProfileDir>C:\Users\YourName\AppData\Roaming\r2modmanPlus-local\InFalsus\profiles\Default</ProfileDir>
    <!-- 游戏根目录保留 Doorstop 和配置相对引用的 dotnet 运行时。 -->
    <GameDir>D:\Steam\steamapps\common\In Falsus</GameDir>
    <!-- 本项目 QQ 群文件接收群；由用户填写，多个群号用逗号或分号分隔。 -->
    <QqGroupIds></QqGroupIds>
    <!-- 可选：QQ 群文件夹 ID；留空或 / 为最外层，使用 get_group_root_files 返回的 folder_id。 -->
    <QqFolderId></QqFolderId>
    <!-- 可选：显式指定现有 interop；省略时依次使用 profile、游戏目录和仓库 .dependencies 快照。 -->
    <!-- <InteropDir>D:\Path\To\BepInEx\interop</InteropDir> -->
  </PropertyGroup>
</Project>
